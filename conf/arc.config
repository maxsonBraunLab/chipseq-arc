/*
 * MaxsonBraun lab config for nf-core/chipseq 2.1.0 on OHSU ARC.
 * Use with:  nextflow -c conf/arc.config run nf-core/chipseq -r 2.1.0 -profile singularity ...
 * (-c is a core option and must come BEFORE `run`.)
 */

params {
    config_profile_name        = 'OHSU ARC - MaxsonBraun lab'
    config_profile_description = 'SLURM batch partition, Singularity, lab Bowtie2 settings'

    // Hard caps applied by nf-core check_max() to every request, including
    // retries. 36 h is the batch partition limit without --qos=long_jobs.
    max_cpus   = 16
    max_memory = '128.GB'
    max_time   = '36.h'
}

process {
    executor = 'slurm'
    queue    = 'batch'
    // No --account (lab convention). Node exclusion copied from the lab's
    // working ScaleTagToolkit driver on ARC; the reason was not recorded.
    // Delete this line to allow those nodes.
    clusterOptions = '--exclude=cnode-07-[5-29],cnode-08-[1-35]'

    // Bowtie2 settings matching maxsonBraunLab/chip_seq: --local for
    // single-end; --local --very-sensitive-local --no-unal --no-mixed
    // -I 10 -X 700 for paired-end. The read-group arguments are copied
    // verbatim from the pipeline's own conf/modules.config so @RG tags are kept.
    withName: 'BOWTIE2_ALIGN' {
        ext.args = {
            [
                meta.read_group ? "--rg-id ${meta.id} --rg SM:${meta.id - ~/_T\d+$/} --rg PL:ILLUMINA --rg LB:${meta.id} --rg PU:1" : '',
                params.seq_center ? "--rg CN:${params.seq_center}" : '',
                meta.single_end ? '--local' : '--local --very-sensitive-local --no-unal --no-mixed -I 10 -X 700'
            ].join(' ').trim()
        }
    }
}

executor {
    name              = 'slurm'
    queueSize         = 50
    submitRateLimit   = '10/1min'
    pollInterval      = '30 sec'
    queueStatInterval = '2 min'
}

singularity {
    enabled    = true
    autoMounts = true   // binds /home, which covers /home/groups/...
    // Image cache: set NXF_SINGULARITY_CACHEDIR (run_chipseq_arc.sbatch does).
}
